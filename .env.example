# ==============================================================================
# WDPCS Accommodation Portal — Client Environment Configuration (.env.example)
# Copy this file to .env or .env.local and fill in your Supabase & Razorpay keys.
# DO NOT COMMIT .env or .env.local to GitHub.
# ==============================================================================

# Supabase Project Configuration (Project Settings -> API)
# Public Anon Key is safe to include in frontend builds.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_public_anon_key_here

# Razorpay Public Key ID (Dashboard -> Settings -> API Keys)
# Only the public Key ID (rzp_test_... or rzp_live_...) goes here.
# NEVER expose RAZORPAY_KEY_SECRET in frontend code or environment variables!
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Optional: Custom API base URL if using external edge function proxy
VITE_API_URL=
