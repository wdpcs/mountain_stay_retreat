# ==============================================================================
# WDPCS Accommodation System — Backend Server Production Configuration
# Copy this file to Server/.env on your production server.
# NEVER commit Server/.env with live secrets to GitHub!
# ==============================================================================

# Server Network & Environment
PORT=5000
NODE_ENV=production

# Cryptographic Session & JWT Secret (Generate a strong 64-char random string)
SESSION_SECRET=wdpcs_super_secure_jwt_random_secret_2026_w208_mountain_retreat

# Razorpay Production API Credentials (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_razorpay_secret

# Supabase Cloud Database Connection
VITE_SUPABASE_URL=https://djbizcrfqqurtfwiivds.supabase.co
# Use Supabase Service Role Key (Project Settings -> API -> service_role secret) for secure server operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
