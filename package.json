{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://rooms.wdpcs.in",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config admin/vite.config.js admin",
    "server": "node Server/Server.js",
    "build": "vite build",
    "build:guest": "vite build",
    "build:admin": "vite build admin --config admin/vite.config.js",
    "build:all": "vite build && vite build admin --config admin/vite.config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:admin": "vite preview admin --config admin/vite.config.js",
    "deploy": "gh-pages -d dist",
    "deploy:guest": "gh-pages -d dist",
    "deploy:admin": "gh-pages -d admin/dist -b gh-pages-admin"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "razorpay": "^2.9.6",
    "react": "^19.2.5",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  }
}
