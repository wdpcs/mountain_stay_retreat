# ==============================================================================
# WDPCS Accommodation System — Production Client Configuration (.env.production.example)
# Rename or copy to .env.production before running 'npm run build:all'.
# DO NOT COMMIT actual live keys or .env.production to GitHub.
# ==============================================================================

# 1. Supabase Cloud Database (Live Project)
VITE_SUPABASE_URL=https://djbizcrfqqurtfwiivds.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_live_anon_key

# 2. Production Central API URL
# Points both Guest (rooms.wdpcs.in) and Admin (roomsadmin.wdpcs.in) frontends to the backend API
VITE_API_URL=https://api.wdpcs.in

# 3. Razorpay Live Public Key ID (Dashboard -> Settings -> API Keys)
# Only the public Key ID (rzp_live_...) belongs in the client bundle.
# Secret key MUST remain on the backend server in Server/.env only!
VITE_RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
